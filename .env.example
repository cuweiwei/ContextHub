# ContextHub configuration

# Port the service listens on
PORT=8787

# Bind address (0.0.0.0 so other devices on the LAN can reach it)
HOST=0.0.0.0

# Directory holding the SQLite database file (mounted as a volume in Docker)
DATA_DIR=./data

# Admin bearer token used to manage clients via REST (POST /v1/clients).
# Generate one with: openssl rand -base64 32
# If unset, admin REST endpoints are disabled (you can still use `npm run cli`).
ADMIN_TOKEN=

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
