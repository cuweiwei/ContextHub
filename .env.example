# ContextHub configuration

# Port the service listens on
PORT=8787

# Bind address (0.0.0.0 so other devices on the LAN can reach it)
HOST=0.0.0.0

# Docker host publication. Keep loopback for local-only access, or set the
# NAS Tailscale IPv4 for private remote access. Never use the NAS public IPv4.
CONTEXTHUB_BIND_ADDRESS=127.0.0.1
CONTEXTHUB_HOST_PORT=8788

# Directory holding the SQLite database file (mounted as a volume in Docker)
DATA_DIR=./data

# Admin bearer token used to manage clients via REST (POST /v1/clients).
# Generate one with: openssl rand -base64 32
# If unset, admin REST endpoints are disabled (you can still use `npm run cli`).
ADMIN_TOKEN=

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Control Center defaults to fail-closed/off. Enable only behind Tailscale
# Serve HTTPS identity headers; never expose the container port directly.
CONTROL_CENTER_ENABLED=false
CONTROL_CENTER_TAILSCALE_AUTH_ENABLED=false
CONTROL_CENTER_TRUSTED_PROXY=false
CONTROL_CENTER_CANONICAL_ORIGIN=
CONTROL_CENTER_SESSION_IDLE_MINUTES=480
CONTROL_CENTER_SESSION_MAX_DAYS=14
CONTROL_CENTER_FRESH_SESSION_MINUTES=5
AGENT_ENROLLMENT_ENABLED=false
MCP_OAUTH_ENABLED=false
LEGACY_API_KEYS_ENABLED=true
OAUTH_ISSUER=
OAUTH_AUDIENCE_BASE=
OAUTH_JWKS_URI=
