{
  "name": "contexthub",
  "version": "0.6.0",
  "description": "Self-hosted context control plane: source projections, governed memory, and ephemeral context compilation.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "pretest": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "posttest": "tsc --noEmit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "benchmark:retrieval": "tsx scripts/retrieval-benchmark.ts",
    "e2e": "bash scripts/e2e.sh",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.2.0",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
