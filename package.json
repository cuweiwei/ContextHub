{
  "name": "contexthub",
  "version": "0.9.0",
  "description": "Self-hosted context control plane: source projections, governed memory, and ephemeral context compilation.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "pretest": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "posttest": "tsc --noEmit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "benchmark:retrieval": "tsx scripts/retrieval-benchmark.ts",
    "eval:neural": "tsx scripts/neural-eval.ts",
    "e2e": "bash scripts/e2e.sh",
    "cli": "tsx src/cli.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "hygiene": "bash scripts/check-repo-hygiene.sh",
    "release:manifest": "tsx scripts/create-release-manifest.ts",
    "production:drift": "tsx scripts/check-production-drift.ts",
    "connector:github": "tsx src/connectors/github-worker-main.ts",
    "connector:calendar": "tsx src/connectors/google-calendar-worker-main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.0",
    "jose": "^6.2.9",
    "opencc-js": "^1.4.1",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
